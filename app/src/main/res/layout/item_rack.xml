<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="6dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:strokeColor="#E1E4ED"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="15dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/rackInitial"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_rack_icon"
                android:gravity="center"
                android:textColor="@color/hero_navy"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="A1" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/rackName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/hero_navy"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    tools:text="Rack A1 - Fresh Produce" />

                <TextView
                    android:id="@+id/rackCode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/hero_text_muted"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    tools:text="RCK-FF-101" />
            </LinearLayout>

            <TextView
                android:id="@+id/rackStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:paddingHorizontal="9dp"
                android:paddingVertical="6dp"
                android:textSize="10sp"
                android:textStyle="bold"
                tools:text="PRINTED" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="13dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="5dp"
                android:layout_weight="1"
                android:background="@drawable/bg_stat_card"
                android:orientation="vertical"
                android:padding="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ITEM TERSCAN"
                    android:textColor="@color/hero_text_muted"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/rackItemCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:textColor="@color/hero_navy"
                    android:textSize="19sp"
                    android:textStyle="bold"
                    tools:text="12" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:layout_weight="1"
                android:background="@drawable/bg_stat_card"
                android:orientation="vertical"
                android:padding="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TOTAL QTY"
                    android:textColor="@color/hero_text_muted"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/rackTotalQuantity"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:textColor="@color/hero_navy"
                    android:textSize="19sp"
                    android:textStyle="bold"
                    tools:text="38" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/openRackButton"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/rackLastScan"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/hero_text_muted"
                android:textSize="12sp"
                tools:text="Terkunci print, mode lihat item" />

            <TextView
                android:id="@+id/openRackText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/hero_navy"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="Lanjut scan" />

            <ImageView
                android:id="@+id/openRackIcon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginStart="4dp"
                android:contentDescription="Buka rack"
                android:src="@drawable/ic_chevron_right" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
