# ============================================================
# Hero Stock Take API - Environment Template
# Copy file ini ke backend/.env lalu edit value sesuai mesin/server.
# ============================================================

# Runtime
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
API_PREFIX=/api

# ------------------------------------------------------------
# Database mode
# mock = in-memory dummy untuk development tanpa SQL Server
# sql  = koneksi ke SQL Server real
# ------------------------------------------------------------
SQL_MODE=sql

# ------------------------------------------------------------
# SQL Server connection
# Pilih salah satu:
#
# Opsi A: baca file koneksi lokal.
#   Cocok kalau kamu punya documentation/connection DB.txt.
#   Kalau pakai opsi ini, kosongkan/comment SQL_SERVER dkk.
#
# Opsi B: isi connection value langsung.
#   Kalau pakai opsi ini, kosongkan/comment STOCKTAKE_CONNECTION_FILE.
# ------------------------------------------------------------
STOCKTAKE_CONNECTION_FILE=../documentation/connection DB.txt

# SQL_SERVER=nama-server-atau-ip
# SQL_PORT=1433
# SQL_DATABASE=StockTake
# SQL_USER=your_sql_user
# SQL_PASSWORD=your_sql_password

SQL_ENCRYPT=true
SQL_TRUST_SERVER_CERTIFICATE=true
SQL_CONNECTION_TIMEOUT_MS=15000
SQL_REQUEST_TIMEOUT_MS=30000

# ------------------------------------------------------------
# Seed behavior
# DB_SEED_ON_START=true akan menjalankan seed saat server start.
# Rekomendasi development: true boleh.
# Rekomendasi production: false.
#
# Seed saat ini hanya membuat/memperbarui:
# - MST_ROLE
# - MST_STOCK_TYPE
# - MST_USERS demo
#
# Seed tidak membuat MST_RACK / TR_STOCK_SCHEDULE karena data itu
# dibuat dari UI web.
#
# SEED_LOC_CODES bisa berisi banyak lokasi. Kode numerik pendek
# otomatis jadi 4 digit: 23 -> 0023.
# ------------------------------------------------------------
DB_SEED_ON_START=false
SEED_LOC_CODES=6168,23
SEED_PASSWORD=prototype

# ------------------------------------------------------------
# Reset testing guard
# db:reset:test default dry-run dan tidak delete data.
#
# Untuk delete betulan, set:
# CONFIRM_RESET=YES
# RESET_SCOPE=ALL
# RESET_DRY_RUN=NO
#
# Jangan set RESET_DRY_RUN=NO di production.
# ------------------------------------------------------------
CONFIRM_RESET=NO
RESET_SCOPE=DRY_RUN_ONLY
RESET_DRY_RUN=YES

# ------------------------------------------------------------
# JWT
# Ganti JWT_SECRET dengan string acak minimal 32 karakter.
# ------------------------------------------------------------
JWT_SECRET=change-this-local-development-secret-at-least-32-characters
JWT_EXPIRES_IN=8h

# ------------------------------------------------------------
# CORS
# Tambahkan origin web jika port/domain berubah.
# ------------------------------------------------------------
CORS_ORIGINS=http://127.0.0.1:4200,http://localhost:4200
