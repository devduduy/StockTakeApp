NODE_ENV=development
HOST=127.0.0.1
PORT=3000
API_PREFIX=/api

# Gunakan "mock" untuk development tanpa database, atau "sql" untuk SQL Server.
SQL_MODE=sql

# Opsi A: baca file koneksi lokal yang sudah ada.
STOCKTAKE_CONNECTION_FILE=../documentation/connection DB.txt

# Opsi B: isi field SQL secara langsung dan kosongkan STOCKTAKE_CONNECTION_FILE.
# SQL_SERVER=nama-server-atau-ip
# SQL_PORT=1433
# SQL_DATABASE=StockTake
# SQL_USER=your_sql_user
# SQL_PASSWORD=your_sql_password
SQL_ENCRYPT=true
SQL_TRUST_SERVER_CERTIFICATE=true
SQL_CONNECTION_TIMEOUT_MS=15000
SQL_REQUEST_TIMEOUT_MS=30000

# Seed hanya mengisi tabel yang benar-benar kosong dan aman dijalankan berulang.
DB_SEED_ON_START=true

# Ganti dengan secret acak minimal 32 karakter sebelum deployment.
JWT_SECRET=change-this-local-development-secret-at-least-32-characters
JWT_EXPIRES_IN=8h

# Angular 18 standalone dev server.
CORS_ORIGINS=http://127.0.0.1:4200,http://localhost:4200

